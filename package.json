{
  "name": "orbis",
  "version": "0.84.1",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "turbo run build",
    "develop": "bash ./scripts/development/develop.sh",
    "develop:web": "turbo run develop --filter=orbis-server --filter=orbis-web",
    "develop:mobile": "turbo run develop --filter=orbis-server --filter=orbis-mobile --ui=tui",
    "develop:all": "turbo run develop --filter=orbis-server --filter=orbis-web --filter=orbis-mobile --ui=tui",
    "develop:server": "turbo run develop --filter=orbis-server",
    "prepare": "git config core.hooksPath .githooks && git config push.recurseSubmodules no",
    "setup": "bash ./scripts/development/setup.sh",
    "pull": "bash ./scripts/development/pull.sh",
    "release": "bash ./scripts/development/release.sh",
    "review:start": "bash ./scripts/development/review-start.sh",
    "review:end": "bash ./scripts/development/review-end.sh"
  },
  "devDependencies": {
    "turbo": "2.11.7"
  }
}
